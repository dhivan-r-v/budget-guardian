PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PORT=3000
# Google AI Studio key (free tier works). Without it, advice uses code-written text.
GEMINI_API_KEY=
# Optional: pin a Gemini model. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=
# PayPal sandbox account that receives money the user approves moving to savings
# (create a US Personal sandbox account for it in the PayPal developer dashboard).
SAVINGS_RECEIVER_EMAIL=
# Optional. 1 = regenerate the seeded history to end today when a new day starts (used on Render).
DEMO_ROLLING=
# Optional. Pins "today" to a fixed date (for testing).
DEMO_AS_OF=
# Optional. Minutes between automatic PayPal syncs (default 15; 0 turns it off).
SYNC_INTERVAL_MINUTES=
# Optional. When set, POST /api/categorize requires "Authorization: Bearer <token>".
ADMIN_TOKEN=
# Optional. Dollars that must stay in the PayPal account after moving money to savings (default 50).
MIN_BALANCE_AFTER_SAVINGS=
# Optional. Keys for device alerts (Web Push). Without them a pair is generated once and kept
# in the database. Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional. Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT=
