{
  "name": "budget-guardian",
  "version": "0.1.0",
  "description": "AI agent that watches PayPal spending, explains spikes, and suggests approved-only trade-offs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "build": "npm --prefix client ci --include=dev && npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "seed": "node scripts/seed.js",
    "spikes": "node scripts/spikes.js",
    "advice": "node --env-file-if-exists=.env scripts/advice.js",
    "categorize": "node --env-file-if-exists=.env scripts/categorize.js",
    "test": "node --test",
    "reset-demo": "node scripts/reset-demo.js",
    "demo-purchase": "node --env-file-if-exists=.env scripts/demo-purchase.js",
    "sync": "node --env-file-if-exists=.env scripts/sync.js"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "express": "^5.3.0"
  }
}
